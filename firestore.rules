rules_version = '2';

/**
 * ============================================================================
 * Firestore Security Rules for MyLink (마이링크)
 * ============================================================================
 * 
 * [보안 모델 개요]
 * 1. 공개 읽기 (Public Read):
 *    - 방문자가 프로필 및 등록된 링크 목록을 자유롭게 열람할 수 있도록
 *      users/{userId} 및 users/{userId}/links/{linkId} 경로의 읽기(get, list)를 허용합니다.
 *    - displayName 및 name 기반의 where 쿼리 검색(중복 확인 및 프로필 페이지 이동)을 지원합니다.
 * 
 * 2. 소유자 쓰기 (Owner-only Write):
 *    - 로그인한 사용자(request.auth != null) 중 본인의 uid와 일치하는 문서 경로(request.auth.uid == userId)에만
 *      생성(create), 수정(update), 삭제(delete)를 허용합니다.
 * 
 * 3. 프로필 편집 및 입력값 검증 (Field Validation & Immutability):
 *    - 사용자 ID(uid, userId)의 불변성 보장 (타인의 uid로 변조 불가)
 *    - 이름(name), 표시이름(displayName) 글자수(1~50자) 제한
 *    - 소개글(bio), 직무(jobTitle), 위치(location) 길이 제한
 *    - 아바타 이미지 URL 및 링크 URL 형식 및 길이(최대 2000자) 제한
 *    - 소셜 링크(socials) 맵 필드 크기 및 타입 검증
 *    - 타임스탬프(createdAt) 생성 후 임의 변조 방지
 * 
 * 4. 최소 권한 원칙 (Default Deny):
 *    - 명시되지 않은 모든 경로에 대한 읽기/쓰기 접근은 엄격히 차단됩니다.
 * 
 * ============================================================================
 * Assumed Data Model:
 * ============================================================================
 * 
 * 1. /users/{userId} (단일 문서)
 *    - uid: string (선택 또는 userId와 일치)
 *    - userId: string (선택 또는 userId와 일치)
 *    - name: string (필수 또는 1~50자)
 *    - displayName: string (선택, 1~50자)
 *    - email: string (선택, 최대 200자)
 *    - bio: string (선택, 최대 500자)
 *    - jobTitle: string (선택, 최대 100자)
 *    - location: string (선택, 최대 100자)
 *    - avatarUrl: string (선택, 최대 2000자)
 *    - firestorePath: string (선택, 최대 100자)
 *    - isGoogleAuth: bool (선택)
 *    - socials: map (선택: instagram, github, youtube, twitter, linkedin, blog, email)
 *    - createdAt: string | timestamp (선택, update 시 불변)
 *    - updatedAt: string | timestamp (선택)
 *    - lastLoginAt: string | timestamp (선택)
 * 
 * 2. /users/{userId}/links/{linkId} (서브컬렉션 문서)
 *    - id: string (선택)
 *    - title: string (필수, 1~100자)
 *    - url: string (필수, 1~2000자, http/https/mailto 등 유효 형식)
 *    - description: string (선택, 최대 200자)
 *    - category: string (선택, 최대 50자)
 *    - icon: string (선택, 최대 50자)
 *    - active: bool (선택)
 *    - order: number (선택)
 *    - createdAt: string | timestamp (선택, update 시 불변)
 *    - updatedAt: string | timestamp (선택)
 * 
 * 3. /users/{userId}/profile/{profileId} (프로필 서브컬렉션 대비)
 * 
 * 4. /user/{userId} 및 /user/{userId}/links/{linkId} (레거시 하위 호환)
 * ============================================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 공통 헬퍼 함수 (Helper Functions)
    // ========================================================================

    // 1. 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 2. 현재 로그인한 사용자가 해당 문서의 소유자(userId)인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. uid 필드가 변경되지 않았는지 확인
    function uidNotModified(userId) {
      let req = request.resource.data;
      let existing = resource.data;
      return (!('uid' in req) || req.uid == userId) &&
             (!('userId' in req) || req.userId == userId) &&
             (!('uid' in existing) || !('uid' in req) || req.uid == existing.uid) &&
             (!('userId' in existing) || !('userId' in req) || req.userId == existing.userId);
    }

    // 4. 생성 시점 타임스탬프(createdAt)가 변경되지 않았는지 확인
    function createdAtNotModified() {
      return !('createdAt' in resource.data) ||
             !('createdAt' in request.resource.data) ||
             request.resource.data.createdAt == resource.data.createdAt;
    }

    // 5. URL 유효성 검증 (최대 2000자, http / https / mailto 허용)
    function isValidUrl(url) {
      return url is string &&
             url.size() >= 1 &&
             url.size() <= 2000 &&
             (url.matches('^https?://.*') || url.matches('^mailto:.*') || url.matches('^/.*'));
    }

    // 6. 소셜 링크 맵 유효성 검증
    function isValidSocials(socials) {
      return socials is map &&
             (!('instagram' in socials) || (socials.instagram is string && socials.instagram.size() <= 200)) &&
             (!('github' in socials) || (socials.github is string && socials.github.size() <= 200)) &&
             (!('youtube' in socials) || (socials.youtube is string && socials.youtube.size() <= 200)) &&
             (!('twitter' in socials) || (socials.twitter is string && socials.twitter.size() <= 200)) &&
             (!('linkedin' in socials) || (socials.linkedin is string && socials.linkedin.size() <= 200)) &&
             (!('blog' in socials) || (socials.blog is string && socials.blog.size() <= 200)) &&
             (!('email' in socials) || (socials.email is string && socials.email.size() <= 200));
    }

    // 7. 사용자 프로필 데이터 검증 함수
    function isValidUser(data, userId) {
      return (!('uid' in data) || data.uid == userId) &&
             (!('userId' in data) || data.userId == userId) &&
             (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 50)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 100)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
             (!('isGoogleAuth' in data) || data.isGoogleAuth is bool) &&
             (!('socials' in data) || isValidSocials(data.socials));
    }

    // 8. 개별 링크 데이터 검증 함수
    function isValidLink(data) {
      return ('title' in data) && (data.title is string) && data.title.size() >= 1 && data.title.size() <= 100 &&
             ('url' in data) && isValidUrl(data.url) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
             (!('active' in data) || data.active is bool) &&
             (!('order' in data) || data.order is number);
    }

    // ========================================================================
    // 1. users 컬렉션 및 하위 서브컬렉션
    // ========================================================================
    match /users/{userId} {
      // 1-1. 사용자 프로필 문서 읽기: 누구나 가능 (비로그인 방문자, 프로필 검색)
      allow read: if true;

      // 1-2. 사용자 프로필 생성: 로그인 사용자 중 본인만 가능
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);

      // 1-3. 사용자 프로필 수정: 본인만 가능 + 유효성 검증 + uid 불변 보장
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data, userId) &&
                       uidNotModified(userId);

      // 1-4. 사용자 프로필 삭제: 본인만 가능
      allow delete: if isOwner(userId);

      // 1-5. 링크 서브컬렉션 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        // 링크 읽기: 누구나 가능 (공개 프로필 조회)
        allow read: if true;

        // 링크 생성: 본인만 가능 + 링크 유효성 검증
        allow create: if isOwner(userId) && isValidLink(request.resource.data);

        // 링크 수정: 본인만 가능 + 유효성 검증 + 생성 시점(createdAt) 변조 방지
        allow update: if isOwner(userId) &&
                         isValidLink(request.resource.data) &&
                         createdAtNotModified();

        // 링크 삭제: 본인만 가능
        allow delete: if isOwner(userId);
      }

      // 1-6. 프로필 서브컬렉션 (users/{userId}/profile/{profileId}) - 분리 구조 대비
      match /profile/{profileId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    // ========================================================================
    // 2. 레거시 user 컬렉션 하위 호환 (user/{userId} 및 user/{userId}/links/{linkId})
    // ========================================================================
    match /user/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /links/{linkId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidLink(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /profile/{profileId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    // ========================================================================
    // 3. 기본 거부 규칙 (Default Deny)
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
